# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Neon Database
DATABASE_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Admin access — only this email may authenticate into /admin, even with a valid session
ALLOWED_ADMIN_EMAIL=

# Resend (Email)
RESEND_API_KEY=

# Google Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Facebook Pixel
NEXT_PUBLIC_FB_PIXEL_ID=

# TikTok Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# AI summaries (admin reports) — via OpenRouter (OpenAI-compatible wire protocol).
# Get a key at https://openrouter.ai/keys. Model names need OpenRouter's
# "vendor/model" slug format (see https://openrouter.ai/models).
AI_API_KEY=
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_PNL=openai/gpt-4o-mini
AI_MODEL_FUNNEL=openai/gpt-4o-mini
AI_MODEL_AFFILIATE=openai/gpt-4o-mini
